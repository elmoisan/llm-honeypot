# --------------------------------------------------------------
# LLM Honeypot — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to Git.
# Only documented variables are accepted.
# --------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Logging
LOG_DIR=logs
LOG_FILE=logs/attacks.jsonl
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

# Geolocation
GEO_API=http://ip-api.com/json/{ip}

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
